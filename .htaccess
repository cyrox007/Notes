Options -Indexes

RewriteEngine On

# Same-origin WebSocket bridge for the native Messenger listener.
# In .htaccess context the pattern is relative to this application directory,
# so the same rule also serves BASE_PATH installations (for example /workspace/ws).
# The backend is deliberately fixed to loopback; clients cannot influence it.
<IfModule mod_proxy.c>
    <IfModule mod_proxy_wstunnel.c>
        RewriteCond %{HTTP:Upgrade} ^websocket$ [NC]
        RewriteCond %{HTTP:Connection} (^|,)\s*upgrade\s*(,|$) [NC]
        RewriteRule ^ws/?$ ws://127.0.0.1:27800/ [P,L]
    </IfModule>
    <IfModule !mod_proxy_wstunnel.c>
        <IfModule mod_proxy_http.c>
            RewriteCond %{HTTP:Upgrade} ^websocket$ [NC]
            RewriteCond %{HTTP:Connection} (^|,)\s*upgrade\s*(,|$) [NC]
            RewriteRule ^ws/?$ http://127.0.0.1:27800/ [P,L]
        </IfModule>
    </IfModule>
</IfModule>

# После успешной установки .env существует: повторный запуск web-installer запрещён.
# Используем директорию самого install.php, поэтому правило работает и при BASE_PATH/subdirectory deploy.
RewriteCond %{REQUEST_FILENAME} ^(.*/)install\.php$
RewriteCond %1.env -f
RewriteRule ^install\.php$ - [F,L]

# Исходный код, служебные каталоги, миграции, module packages и CI metadata никогда не должны
# отдаваться как static files из project web-root.
RewriteRule ^(?:app|bin|config|core|database|docs|modules|tests|tools|vendor|ws_server|\.github|\.git|\.logs)(?:/|$) - [F,L,NC]

# Не отдаём конфигурацию и repository metadata напрямую.
<IfModule mod_authz_core.c>
    <FilesMatch "^(?:\.env(?:\..*)?|default\.env|composer\.(?:json|lock)|core\.php|\.gitignore|README\.md|CHANGELOG\.md|TASKS_MODULE_README\.md)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "^(?:\.env(?:\..*)?|default\.env|composer\.(?:json|lock)|core\.php|\.gitignore|README\.md|CHANGELOG\.md|TASKS_MODULE_README\.md)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule .* index.php [L]

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(), geolocation=(), microphone=(self), payment=(), usb=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    # Content-Security-Policy is emitted by PHP Core\\SecurityHeaders with a per-request nonce.
</IfModule>
