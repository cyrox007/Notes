# ============================================
# Файл переменных окружения (по умолчанию)
# Скопируйте этот файл в .env и настройте под себя
# ============================================

# --------------------------------------------
# База данных
# --------------------------------------------
DBDRIVER=mysql
DBHOST=localhost
DBPORT=3306
DBUSER=root
DBPASS=your_secure_password_here
DBNAME=messenger_db

# --------------------------------------------
# Шифрование сообщений мессенджера (ОБЯЗАТЕЛЬНО!)
# Новые сообщения используют XChaCha20-Poly1305.
# Секрет должен содержать не менее 32 случайных символов.
# Пример: openssl rand -hex 32
# --------------------------------------------
MSG_SECRET_KEY=change_this_to_a_long_random_messenger_secret

# Только для чтения старых AES-CBC сообщений во время миграции.
# Не задавайте на новых установках. После перешифрования legacy-данных удалить.
# MSG_LEGACY_SECRET_KEY=

# --------------------------------------------
# Шифрование заметок
# CryptMethods использует UNIQUE_KEY + XChaCha20-Poly1305.
# UNIQUE_KEY обязателен и должен содержать минимум 32 случайных символа.
# NOTE_SECRET_KEY оставлен только для совместимости старых конфигураций и
# текущим CryptMethods не используется.
# --------------------------------------------
UNIQUE_KEY=change_this_to_a_long_random_note_encryption_secret
# NOTE_SECRET_KEY=

# --------------------------------------------
# Приватное хранилище
# ДОЛЖНО находиться вне document root и быть доступно PHP на запись.
# --------------------------------------------
PRIVATE_STORAGE_PATH=/var/lib/notes/private
UPLOAD_DIR=/var/www/uploads/file_manager
NOTES_UPLOAD_DIR=/var/www/uploads/notes
MESSENGER_UPLOAD_DIR=/var/www/uploads/messenger

# --------------------------------------------
# Signed updater: staging, transaction state, rollback backup и release candidate
# Все пути должны быть абсолютными, доступными PHP на запись и находиться ВНЕ
# каталога приложения/document root. Не размещайте их внутри public web tree.
# Если не заданы, updater использует безопасные подкаталоги PRIVATE_STORAGE_PATH.
# Для production рекомендуется разделять staging/state/backups/releases явно.
# Remote delivery принимает только public HTTPS feed; feed — только указатель,
# доверие определяется Ed25519-подписью manifest и SHA-256 пакета из manifest.
# --------------------------------------------
UPDATE_STAGING_PATH=/var/lib/notes/update-staging
UPDATE_STATE_PATH=/var/lib/notes/update-state
# Optional dedicated external checkpoint directory for UNIQUE_KEY/MSG_SECRET_KEY rotation.
# If empty, UPDATE_STATE_PATH/data-key-rotation is used.
DATA_KEY_ROTATION_STATE_PATH=
UPDATE_BACKUP_PATH=/var/lib/notes/update-backups
UPDATE_RELEASE_PATH=/var/lib/notes/update-releases
UPDATE_FEED_URL=
UPDATE_CHANNEL=stable
# offline preserves signed/manual delivery; online requires server-issued credentials.
UPDATE_ACCESS_MODE=offline
# Absolute private path outside the application tree; created by bin/update_activate.php.
UPDATE_CREDENTIALS_FILE=

# --------------------------------------------
# Ограничения на загрузку файлов
# --------------------------------------------
MAX_UPLOAD_SIZE=10485760
NOTES_MAX_UPLOAD_SIZE=10485760
MAX_NOTE_ATTACHMENTS=10
MESSENGER_MAX_UPLOAD_SIZE=10485760
MESSENGER_MAX_VOICE_SIZE=5242880
MESSENGER_GROUP_AVATAR_MAX_SIZE=2097152
PROFILE_AVATAR_MAX_SIZE=2097152
MESSENGER_ORPHAN_TTL_SECONDS=86400
MESSENGER_SEARCH_SCAN_LIMIT=1000

# --------------------------------------------
# Retention / permanent purge
# Soft-deleted live data and deactivated accounts are retained before irreversible purge.
# Preview: php bin/retention.php --json
# Apply:   php bin/retention.php --apply --yes --json
# --------------------------------------------
RETENTION_SOFT_DELETE_DAYS=30
RETENTION_DEACTIVATED_ACCOUNT_DAYS=30
# Authenticated user-action journal retention. Preview/purge: php bin/audit_log.php
AUDIT_LOG_RETENTION_DAYS=180

# --------------------------------------------
# Настройки приложения
# --------------------------------------------
SITEURL=http://localhost
BASE_PATH=/
REGISTRATION_INVITE_CODE=

# --------------------------------------------
# Native WebSocket сервер
# --------------------------------------------
# Встроенный PHP listener по умолчанию слушает только loopback. Не открывайте
# WS_PORT наружу: публичный ws/wss endpoint проксируется веб-сервером на WS_PORT.
WS_HOST=127.0.0.1
WS_PORT=27800
WS_PUBLIC_URL=ws://localhost/ws
WS_TICKET_SECRET=change_this_to_a_long_random_websocket_ticket_secret
WS_ALLOWED_ORIGINS=http://localhost
# Защита native event loop от исчерпания ресурсов.
WS_MAX_CONNECTIONS=256
WS_MAX_PAYLOAD_BYTES=2097152
# Проверка listener/proxy: php bin/ws_doctor.php

# --------------------------------------------
# Логирование / security observability
# --------------------------------------------
LOG_LEVEL=DEBUG
LOG_FILE=/var/log/messenger/app.log
# Structured append-only JSONL security events. If empty, defaults to
# PRIVATE_STORAGE_PATH/logs/security-events.jsonl.
SECURITY_EVENT_LOG_PATH=
OBSERVABILITY_WINDOW_SECONDS=900
OBSERVABILITY_CRITICAL_ALERT=1
OBSERVABILITY_AUTH_FAILURE_ALERT=10
OBSERVABILITY_RATE_LIMIT_ALERT=3

# --------------------------------------------
# Безопасность / rate limiting
# --------------------------------------------
SESSION_LIFETIME=3600
MAX_LOGIN_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
MAX_2FA_ATTEMPTS=8
TWO_FACTOR_RATE_LIMIT_WINDOW_SECONDS=300
UPLOAD_RATE_LIMIT_ATTEMPTS=60
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_STORAGE_PATH=
DEPLOYMENT_NODE_COUNT=1
TRUSTED_PROXY_IPS=
CSRF_ENABLED=true

# --------------------------------------------
# Инструкции по безопасности
# --------------------------------------------
# 1. Все активные ключи должны быть уникальными случайными секретами.
# 2. Никогда не коммитьте .env в репозиторий и не включайте его в backup archive.
# 3. Для prod/stage/dev используйте разные ключи.
# 4. PRIVATE_STORAGE_PATH держите вне document root.
# 5. WS_PUBLIC_URL в HTTPS-развёртывании должен использовать wss://; TLS завершается на reverse proxy.
# 6. WS_ALLOWED_ORIGINS должен содержать только доверенные origin приложения.
# 7. MSG_LEGACY_SECRET_KEY допустим только на время миграции старых сообщений.
# 8. UNIQUE_KEY/MSG_SECRET_KEY ротируются только через maintenance + bin/rotate_data_keys.php; не меняйте их напрямую.
# 9. WS_TICKET_SECRET можно ротировать с рестартом HTTP/WS процессов; существующие socket tickets будут инвалидированы.
# 10. Messenger attachments, voice recordings и group avatars хранятся под PRIVATE_STORAGE_PATH/messenger.
# 11. Notes attachments хранятся под PRIVATE_STORAGE_PATH/notes и выдаются только через owner/share ACL endpoints.
# 12. Новые Notes attachment bytes пока не шифруются at-rest: is_encrypted=0 отражает реальность.
# 13. Пользовательские аватары хранятся под PRIVATE_STORAGE_PATH/users.
# 14. Запускайте cleanup_messenger_orphans.php по cron/systemd timer.
# 15. MESSENGER_SEARCH_SCAN_LIMIT ограничивает стоимость decrypt-scan поиска.
# 16. Голосовые записи Messenger принимаются отдельным /messenger/voice-upload endpoint.
# 17. REGISTRATION_INVITE_CODE обязателен для web-registration; пустое значение закрывает регистрацию.
# 18. Для нескольких web-узлов RATE_LIMIT_STORAGE_PATH должен указывать на общий POSIX volume с flock.
# 19. TRUSTED_PROXY_IPS перечисляет адреса ваших proxy/load balancer.
# 20. Multi-node PHP sessions требуют sticky sessions или общий session backend.
# 21. Регулярно выполняйте backup/restore drill по docs/OPERATIONS.md.
# 22. После запуска native WebSocket server выполните php bin/ws_doctor.php: [OK] listener ещё не означает, что публичный /ws proxy настроен.
# 23. UPDATE_STAGING_PATH, UPDATE_STATE_PATH, UPDATE_BACKUP_PATH и UPDATE_RELEASE_PATH должны находиться вне application/document-root tree; updater намеренно откажется работать с внутренними путями.
# 24. Rollback code snapshot намеренно не содержит .env, cache/compile, uploads или PRIVATE_STORAGE_PATH: эти mutable/secret данные не должны перезаписываться при code rollback.
# 25. UPDATE_RELEASE_PATH содержит только проверенные release candidates. Он не является document root и не должен обслуживаться веб-сервером напрямую.
# 26. UPDATE_FEED_URL должен быть public HTTPS URL без redirect на private/local network; UPDATE_CHANNEL ограничен alpha/beta/stable.\n# 27. DATA_KEY_ROTATION_STATE_PATH, если задан, должен быть абсолютным writable каталогом вне application/document root.\n# 28. SECURITY_EVENT_LOG_PATH, если задан, должен быть абсолютным writable JSONL path вне application/document root; проверка: php bin/observability.php --json.\n# 29. Permanent purge сначала проверяйте через php bin/retention.php; --apply требует --yes и необратим для live-data.
