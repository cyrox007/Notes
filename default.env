# ============================================
# Файл переменных окружения (по умолчанию)
# Скопируйте этот файл в .env и настройте под себя
# ============================================

# --------------------------------------------
# База данных
# --------------------------------------------
DBDRIVER=mysql
DBHOST=localhost
DBPORT=3306
DBUSER=root
DBPASS=your_secure_password_here
DBNAME=messenger_db

# --------------------------------------------
# Шифрование сообщений мессенджера (ОБЯЗАТЕЛЬНО!)
# Ключ должен быть 32 символа для AES-256
# Сгенерируйте случайный ключ: openssl rand -hex 32
# --------------------------------------------
MSG_SECRET_KEY=change_this_to_your_32_char_secret_key_now!

# --------------------------------------------
# Шифрование заметок (ОБЯЗАТЕЛЬНО для Notes 2.0+)
# Ключ должен быть 32 символа для AES-256
# Сгенерируйте случайный ключ: openssl rand -hex 32
# --------------------------------------------
NOTE_SECRET_KEY=change_this_to_your_32_char_note_secret_key!

# --------------------------------------------
# Дополнительные ключи шифрования
# UNIQUE_KEY используется текущим CryptMethods и обязателен.
# --------------------------------------------
UNIQUE_KEY=change_this_to_a_long_random_secret

# --------------------------------------------
# Приватное хранилище
# ДОЛЖНО находиться вне document root и быть доступно PHP на запись.
# Если переменная не задана, FileController использует каталог
# notes-private-storage рядом с SITEPATH.
# --------------------------------------------
PRIVATE_STORAGE_PATH=/var/lib/notes/private

# Старые переменные пока оставлены для совместимости других модулей.
UPLOAD_DIR=/var/www/uploads/file_manager
NOTES_UPLOAD_DIR=/var/www/uploads/notes
MESSENGER_UPLOAD_DIR=/var/www/uploads/messenger

# --------------------------------------------
# Ограничения на загрузку файлов
# --------------------------------------------
MAX_UPLOAD_SIZE=10485760
MAX_NOTE_ATTACHMENTS=10

# --------------------------------------------
# Настройки приложения
# --------------------------------------------
SITEURL=http://localhost
BASE_PATH=/

# --------------------------------------------
# WebSocket сервер
# --------------------------------------------
WS_HOST=0.0.0.0
WS_PORT=8080

# --------------------------------------------
# Логирование
# --------------------------------------------
LOG_LEVEL=DEBUG
LOG_FILE=/var/log/messenger/app.log

# --------------------------------------------
# Безопасность
# --------------------------------------------
SESSION_LIFETIME=3600
MAX_LOGIN_ATTEMPTS=5
CSRF_ENABLED=true

# --------------------------------------------
# Инструкции по безопасности:
#
# 1. Все ключи должны быть уникальными случайными секретами.
# 2. Никогда не коммитьте файл .env в репозиторий.
# 3. Для prod/stage/dev используйте разные ключи.
# 4. PRIVATE_STORAGE_PATH держите вне document root.
# 5. Регулярно проверяйте права каталога, backup и ротацию ключей.
# --------------------------------------------
