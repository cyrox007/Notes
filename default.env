# ============================================
# Файл переменных окружения (по умолчанию)
# Скопируйте этот файл в .env и настройте под себя
# ============================================

# --------------------------------------------
# База данных
# --------------------------------------------
DBDRIVER=mysql
DBHOST=localhost
DBPORT=3306
DBUSER=root
DBPASS=your_secure_password_here
DBNAME=messenger_db

# --------------------------------------------
# Шифрование сообщений мессенджера (ОБЯЗАТЕЛЬНО!)
# Новые сообщения используют XChaCha20-Poly1305.
# Секрет должен содержать не менее 32 случайных символов.
# Пример: openssl rand -hex 32
# --------------------------------------------
MSG_SECRET_KEY=change_this_to_a_long_random_messenger_secret

# Только для чтения старых AES-CBC сообщений во время миграции.
# Не задавайте на новых установках. После перешифрования legacy-данных удалить.
# MSG_LEGACY_SECRET_KEY=

# --------------------------------------------
# Шифрование заметок
# CryptMethods использует UNIQUE_KEY + XChaCha20-Poly1305.
# UNIQUE_KEY обязателен и должен содержать минимум 32 случайных символа.
# NOTE_SECRET_KEY оставлен только для совместимости старых конфигураций и
# текущим CryptMethods не используется.
# --------------------------------------------
UNIQUE_KEY=change_this_to_a_long_random_note_encryption_secret
# NOTE_SECRET_KEY=

# --------------------------------------------
# Приватное хранилище
# ДОЛЖНО находиться вне document root и быть доступно PHP на запись.
# File manager и новые messenger attachments используют это хранилище.
# --------------------------------------------
PRIVATE_STORAGE_PATH=/var/lib/notes/private

# Legacy paths: не использовать для новых messenger attachments.
UPLOAD_DIR=/var/www/uploads/file_manager
NOTES_UPLOAD_DIR=/var/www/uploads/notes
MESSENGER_UPLOAD_DIR=/var/www/uploads/messenger

# --------------------------------------------
# Ограничения на загрузку файлов
# --------------------------------------------
MAX_UPLOAD_SIZE=10485760
# Отдельный лимит мессенджера. Если не задан, используется MAX_UPLOAD_SIZE.
MESSENGER_MAX_UPLOAD_SIZE=10485760
# Голосовые сообщения имеют более строгий отдельный лимит, по умолчанию 5 МБ.
MESSENGER_MAX_VOICE_SIZE=5242880
# Аватар группы: только JPEG/PNG/WebP; отдельный лимит, по умолчанию 2 МБ.
MESSENGER_GROUP_AVATAR_MAX_SIZE=2097152
# Неотправленные messenger attachments старше TTL помечаются удалёнными
# и очищаются командой: php bin/cleanup_messenger_orphans.php
MESSENGER_ORPHAN_TTL_SECONDS=86400
# Поиск по encrypted messages расшифровывает только последние N доступных сообщений.
# Увеличивайте осторожно: это CPU-bound операция, plaintext-индекс в БД не создаётся.
MESSENGER_SEARCH_SCAN_LIMIT=1000
MAX_NOTE_ATTACHMENTS=10

# --------------------------------------------
# Настройки приложения
# --------------------------------------------
SITEURL=http://localhost
BASE_PATH=/

# --------------------------------------------
# WebSocket сервер
# --------------------------------------------
WS_HOST=0.0.0.0
WS_PORT=27800
# Публичный URL, к которому подключается браузер. В production используйте wss://.
WS_PUBLIC_URL=ws://localhost:27800
# Не менее 32 случайных символов. Пример: openssl rand -hex 32
WS_TICKET_SECRET=change_this_to_a_long_random_websocket_ticket_secret
# Через запятую. Если не задано, сервер использует SITEURL.
WS_ALLOWED_ORIGINS=http://localhost

# --------------------------------------------
# Логирование
# --------------------------------------------
LOG_LEVEL=DEBUG
LOG_FILE=/var/log/messenger/app.log

# --------------------------------------------
# Безопасность
# --------------------------------------------
SESSION_LIFETIME=3600
MAX_LOGIN_ATTEMPTS=5
CSRF_ENABLED=true

# --------------------------------------------
# Инструкции по безопасности:
#
# 1. Все активные ключи должны быть уникальными случайными секретами.
# 2. Никогда не коммитьте файл .env в репозиторий.
# 3. Для prod/stage/dev используйте разные ключи.
# 4. PRIVATE_STORAGE_PATH держите вне document root.
# 5. WS_PUBLIC_URL в HTTPS-развёртывании должен использовать wss://.
# 6. WS_ALLOWED_ORIGINS должен содержать только доверенные origin приложения.
# 7. MSG_LEGACY_SECRET_KEY допустим только на время миграции старых сообщений.
# 8. Перед ротацией UNIQUE_KEY/MSG_SECRET_KEY нужен план перешифрования данных.
# 9. Messenger attachments, voice recordings и group avatars должны храниться только под PRIVATE_STORAGE_PATH/messenger.
# 10. Запускайте cleanup_messenger_orphans.php по cron/systemd timer, например каждые 15–60 минут.
# 11. MESSENGER_SEARCH_SCAN_LIMIT ограничивает стоимость decrypt-scan поиска; не превращайте его в полный scan таблицы.
# 12. Голосовые записи принимаются только отдельным `/messenger/voice-upload` endpoint с собственным MIME allowlist.
# 13. Регулярно проверяйте права каталога, backup и ротацию ключей.
# --------------------------------------------
