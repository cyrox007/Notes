# ============================================
# Файл переменных окружения (по умолчанию)
# Скопируйте этот файл в .env и настройте под себя
# ============================================

# --------------------------------------------
# База данных
# --------------------------------------------
DBDRIVER=mysql
DBHOST=localhost
DBPORT=3306
DBUSER=root
DBPASS=your_secure_password_here
DBNAME=messenger_db

# --------------------------------------------
# Шифрование сообщений (ОБЯЗАТЕЛЬНО!)
# Ключ должен быть 32 символа для AES-256
# Сгенерируйте случайный ключ: openssl rand -hex 32
# --------------------------------------------
MSG_SECRET_KEY=change_this_to_your_32_char_secret_key_now!

# --------------------------------------------
# Дополнительные ключи шифрования (опционально)
# --------------------------------------------
UNIQUE_KEY=unique_encryption_key_for_files
SECONDARY_KEY=secondary_key_for_backup_encryption

# --------------------------------------------
# Пути загрузки файлов
# --------------------------------------------
UPLOAD_DIR=/var/www/uploads/messenger

# --------------------------------------------
# Настройки приложения
# --------------------------------------------
SITEURL=http://localhost
BASE_PATH=/

# --------------------------------------------
# WebSocket сервер
# --------------------------------------------
WS_HOST=0.0.0.0
WS_PORT=8080

# --------------------------------------------
# Логирование
# --------------------------------------------
LOG_LEVEL=DEBUG
LOG_FILE=/var/log/messenger/app.log

# --------------------------------------------
# Безопасность
# --------------------------------------------
SESSION_LIFETIME=3600
MAX_LOGIN_ATTEMPTS=5
CSRF_ENABLED=true

# --------------------------------------------
# Инструкции по безопасности:
# 
# 1. MSG_SECRET_KEY должен быть уникальным и секретным!
#    Сгенерируйте его командой: openssl rand -hex 32
#    
# 2. Никогда не коммитьте файл .env в репозиторий!
#    Добавьте .env в .gitignore
#
# 3. Для продакшена используйте разные ключи
#    для разных окружений (dev/stage/prod)
#
# 4. Регулярно меняйте пароли БД и ключи шифрования
# --------------------------------------------
