{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workspace-organizer.local/schema/module-manifest-0.14.json",
  "title": "Workspace Organizer module manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "core",
    "provider",
    "dependencies",
    "conflicts",
    "capabilities",
    "requires_capabilities",
    "routes",
    "migrations",
    "storage",
    "healthcheck"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 96
    },
    "name": {"type": "string", "minLength": 1, "maxLength": 160},
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "core": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constraint"],
      "properties": {
        "constraint": {"type": "string", "minLength": 1, "maxLength": 120}
      }
    },
    "provider": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\\\[A-Za-z_][A-Za-z0-9_]*)+$",
      "maxLength": 255
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/moduleConstraint"}
    },
    "conflicts": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/moduleConstraint"}
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/capability"}
    },
    "requires_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/capability"}
    },
    "routes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider"],
      "properties": {
        "provider": {"$ref": "#/$defs/className"},
        "prefixes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^/[A-Za-z0-9/_-]*$",
            "maxLength": 180
          }
        }
      }
    },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "path"],
      "properties": {
        "namespace": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
        "path": {"$ref": "#/$defs/relativePath"}
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace"],
      "properties": {
        "namespace": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$"}
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"}
    },
    "settings_schema": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/relativePath"}
      ]
    },
    "assets": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/relativePath"}
    },
    "healthcheck": {"$ref": "#/$defs/className"},
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature"],
      "properties": {
        "feature": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
        "required": {"type": "boolean", "default": false}
      }
    }
  },
  "$defs": {
    "className": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\\\[A-Za-z_][A-Za-z0-9_]*)+$",
      "maxLength": 255
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\x00)[A-Za-z0-9._/-]+$",
      "minLength": 1,
      "maxLength": 255
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"
    },
    "moduleConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "constraint"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
        "constraint": {"type": "string", "minLength": 1, "maxLength": 120}
      }
    }
  }
}
